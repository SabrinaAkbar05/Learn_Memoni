rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staff() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['expert','admin'];
    }
    match /contributions/{uid}/{filename} {
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow read: if (request.auth != null && request.auth.uid == uid) || staff();
    }
  }
}
